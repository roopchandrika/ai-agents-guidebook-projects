# LLM (any LiteLLM model string). Default is local via Ollama.
MODEL=ollama/qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...   # only if MODEL=openai/...

# https://brightdata.com -> Account settings -> API key
BRIGHTDATA_API_KEY=
# Name of a "SERP API" zone you create in the Bright Data control panel
BRIGHTDATA_SERP_ZONE=serp_api1

# Optional: Web Scraper API dataset IDs (copy from Bright Data -> Web Scrapers -> each scraper's API tab).
# When set, links found by the SERP API are enriched with full post/video data.
BRIGHTDATA_DATASET_X=
BRIGHTDATA_DATASET_INSTAGRAM=
BRIGHTDATA_DATASET_YOUTUBE=
BRIGHTDATA_DATASET_LINKEDIN=
