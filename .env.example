# LLM (any LiteLLM model string). Default is local via Ollama.
MODEL=ollama/qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...   # only if MODEL=openai/...

# https://app.linkup.so  (free credits on sign-up)
LINKUP_API_KEY=
# "standard" (fast) or "deep" (slower, more thorough)
LINKUP_DEPTH=standard
