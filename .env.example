# https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# https://typefully.com -> Settings -> API & Integrations (optional; posts are always saved to output/)
TYPEFULLY_API_KEY=

# Any OpenAI-compatible endpoint. Default: local DeepSeek-R1 via Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=deepseek-r1:7b
