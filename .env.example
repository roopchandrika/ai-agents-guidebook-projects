# LLM (any LiteLLM model string). Default is local via Ollama.
# The guidebook uses DeepSeek-R1 (ollama/deepseek-r1:7b); Qwen 3 handles tool calls more reliably.
MODEL=ollama/qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...   # only if MODEL=openai/...

# Maximum number of documents to plan
MAX_DOCS=5
