# LLM (any LiteLLM model string). Default is local via Ollama.
MODEL=ollama/qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...   # only if MODEL=openai/...

# https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# Book size (5 chapters x ~4000 words is close to the guidebook's 20k-word book)
NUM_CHAPTERS=5
WORDS_PER_CHAPTER=1500
