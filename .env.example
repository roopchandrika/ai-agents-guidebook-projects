# Speech-to-text: https://www.assemblyai.com
ASSEMBLYAI_API_KEY=
# Text-to-speech: https://play.cartesia.ai
CARTESIA_API_KEY=
# LLM + LlamaIndex embeddings (LlamaIndex uses OpenAI embeddings by default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: use a local LLM for the conversation (embeddings still use OpenAI)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Only needed for `python agent.py dev` (https://cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
